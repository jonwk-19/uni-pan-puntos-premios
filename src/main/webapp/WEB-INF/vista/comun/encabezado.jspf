<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Pan, Puntos y Premios</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css">
</head>
<body>
<header class="barra">
    <a class="marca" href="${pageContext.request.contextPath}/inicio">Pan, Puntos y Premios</a>
    <nav>
        <a href="${pageContext.request.contextPath}/productos">Productos</a>
        <a href="${pageContext.request.contextPath}/inventario">Inventario</a>
        <a href="${pageContext.request.contextPath}/clientes">Clientes</a>
        <a href="${pageContext.request.contextPath}/pedidos">Pedidos</a>
        <a href="${pageContext.request.contextPath}/reportes">Reportes</a>
    </nav>
</header>
<main class="contenido">
<c:if test="${not empty sessionScope.mensaje}">
    <p class="aviso">${sessionScope.mensaje}</p>
    <c:remove var="mensaje" scope="session"/>
</c:if>
